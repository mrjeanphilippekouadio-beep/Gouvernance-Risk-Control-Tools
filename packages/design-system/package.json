{
  "name": "@djamo/design-system",
  "version": "0.1.0",
  "description": "Djamo design system — React components and design tokens, reusable across projects.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "gridstack": "^14.0.0",
    "lucide-react": "^0.545.0",
    "react-chartjs-2": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2"
  }
}
