# Copy to .env.local (gitignored by the Vite template's default .gitignore).

VITE_API_BASE_URL=http://localhost:8080

# Native GRC feedback widget. Set to false in staging when Userback is enabled.
VITE_NATIVE_FEEDBACK_ENABLED=true

# Userback widget (staging/QA).
# The access token is a public widget token; configure it in the Render environment, not in Git.
# VITE_USERBACK_ENABLED=true
# VITE_USERBACK_ACCESS_TOKEN=xxxxxxxxxxxxxxxx

# Normal application mode.
VITE_AUTH_PROVIDER=google
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Staging/TestSprite only. Do not enable in production.
# VITE_AUTH_PROVIDER=local
# VITE_LOCAL_AUTH_EMAIL=qagrctest@gmail.com
