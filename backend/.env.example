# Copy to .env and fill in real values. Never commit .env (see .gitignore).

NODE_ENV=development
PORT=8080

# Neon Postgres connection string — get it from the Neon project dashboard.
# Must include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/grc?sslmode=require
DATABASE_POOL_MAX=10

# Production migrations ONLY: use a dedicated privileged migration connection.
# Never inject MIGRATION_DATABASE_URL into the long-running Cloud Run runtime.
# MIGRATION_DATABASE_URL=postgresql://migration_user:password@ep-example-123456.eu-central-1.aws.neon.tech/grc?sslmode=require

# OAuth client id from Google Cloud Console (Identity Platform / Workspace SSO).
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Local development only. Leave unset in production: Cloud Run uses its
# assigned user-managed service identity and Application Default Credentials.
# GOOGLE_DRIVE_CREDENTIALS_PATH=./secrets/drive-service-account.json

# Comma-separated origins the frontend is served from (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional — Telegram bot notifications (Phase A). Leave both unset to
# disable; the app runs fine without them. Token from @BotFather; chat_id
# from https://api.telegram.org/bot<token>/getUpdates after messaging the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
