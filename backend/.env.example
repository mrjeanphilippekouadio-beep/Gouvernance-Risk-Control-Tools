# Copy to .env and fill in real values. Never commit .env (see .gitignore).

NODE_ENV=development
APP_ENV=development
PORT=8080

# Neon Postgres connection string — get it from the Neon project dashboard.
DATABASE_URL=postgresql://grc_app_runtime:password@ep-example-123456.eu-central-1.aws.neon.tech/grc?sslmode=verify-full&channel_binding=require
DATABASE_POOL_MAX=10

# Production migrations ONLY: use a dedicated privileged migration connection.
# Never inject MIGRATION_DATABASE_URL into the long-running runtime.
# MIGRATION_DATABASE_URL=postgresql://grc_migrator_runtime:password@ep-example-123456.eu-central-1.aws.neon.tech/grc?sslmode=verify-full&channel_binding=require

# Authentication provider. Keep "google" for normal environments.
AUTH_PROVIDER=google

# Required when AUTH_PROVIDER=google.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Staging/TestSprite only: set AUTH_PROVIDER=local.
# Multiple QA accounts are configured as JSON; there is no comma/semicolon separator.
# Keep password hashes and token secret only in Render/secret storage; never commit them.
# LOCAL_AUTH_USERS_JSON=[{"email":"qagrctest@gmail.com","passwordHash":"scrypt$<salt>$<derived-key>"}]
# LOCAL_AUTH_TOKEN_SECRET=<random-secret-at-least-32-characters>
# LOCAL_AUTH_TOKEN_TTL_SECONDS=3600
#
# Legacy single-account variables remain supported temporarily:
# LOCAL_AUTH_EMAIL=qagrctest@gmail.com
# LOCAL_AUTH_PASSWORD_HASH=scrypt$<salt>$<derived-key>

# Document storage (evidence files). Only google_drive for now.
DOCUMENT_STORAGE_PROVIDER=google_drive
# Shared Drive folder ids. Deleting an evidence MOVES the file to the
# "deleted" folder (never Drive trash, never permanent delete).
# DRIVE_ACTIVE_FOLDER_ID=
# DRIVE_DELETED_FOLDER_ID=
# adc = Application Default Credentials (Cloud Run identity);
# key_file = service-account JSON key, requires GOOGLE_DRIVE_CREDENTIALS_PATH
# (allowed in production, e.g. a Render secret file). With adc, the path must be unset.
# The service account needs the "Content manager" role on both Shared Drives.
GOOGLE_DRIVE_AUTH_MODE=adc
# GOOGLE_DRIVE_CREDENTIALS_PATH=./secrets/drive-service-account.json

# Comma-separated origins the frontend is served from (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Reverse proxies in front of the app, so rate limiting sees the real client
# IP. 0 locally; 3 on Render (Cloudflare + Render proxy + in-container proxy).
TRUST_PROXY_HOPS=0

# Graceful stop (I-RT3-01): TOTAL budget in ms after SIGTERM/SIGINT for running requests, in-flight
# notifications and pool close. Rule: platform grace period minus 2 s.
# Cloud Run (10 s grace) -> 8000 (default). Render: grace to be confirmed by DevOps (A09).
# SHUTDOWN_DRAIN_MS=8000

# Optional — Telegram bot notifications (Phase A).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# q260: platform super-administrators = comma-separated exact e-mail addresses (lowercased, no wildcard, max 20).
# Empty = nobody can manage clients (fail closed). Not grantable by any role.
SUPER_ADMIN_EMAILS=
# q275: domains the identity provider must ATTEST (Google `hd`) for a super-administrator. REQUIRED together with
# SUPER_ADMIN_EMAILS: empty = nobody is a super-administrator. At least two addresses (q277).
# q285: SUPER_ADMIN_DOMAINS is also THE list of company domains: ANY user whose address is on one of these domains must have
# that domain attested by the identity provider (Google `hd`) or the login is refused (all users, not only super-administrators).
# Other domains are unaffected. Local tokens follow the same rule (set LOCAL_AUTH_ATTESTED_DOMAIN in staging).
SUPER_ADMIN_DOMAINS=
