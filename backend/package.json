{
  "name": "@grc-tools/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GRC Tools backend — domain services, repository layer, HTTP API (Cloud Run).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/infrastructure/database/postgres/runMigrations.ts",
    "agent:ask": "tsx src/scripts/telegramAsk.ts",
    "agent:poll": "tsx src/scripts/telegramPoll.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
